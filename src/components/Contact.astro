---
---
<section id="contacto" class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4">
        
        <div class="text-center mb-12">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mb-2">
                Contáctanos
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto text-sm sm:text-base">
                Déjanos tus datos y te responderemos a la brevedad para revivir tu consola.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-stretch max-w-5xl mx-auto bg-gray-50 dark:bg-gray-800/40 rounded-3xl overflow-hidden border border-gray-100 dark:border-gray-800 shadow-sm">
            
            <div class="relative min-h-62.5 md:min-h-full bg-linear-to-br from-green-600 to-emerald-800 p-8 flex flex-col justify-between overflow-hidden">
                <div class="absolute inset-0 bg-[url('/public/img/logo.png')] bg-no-repeat bg-center opacity-10 scale-150 pointer-events-none"></div>
                
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>

                <div class="relative z-10 my-auto text-center md:text-left">
                    <h3 class="text-2xl font-black text-white mb-3 tracking-wide uppercase">
                        Zombie Mitosis
                    </h3>
                    <p class="text-green-100 text-sm sm:text-base max-w-sm leading-relaxed">
                        Trae tu Xbox al laboratorio de reparación. Diagnósticos certeros y un servicio libre de infecciones.
                    </p>
                </div>
            </div>

            <div class="p-6 sm:p-8 lg:p-10 bg-white dark:bg-gray-900">
                <form id="formulario-contacto" class="space-y-5">
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
                                Nombre completo
                            </label>
                            <input type="text" name="user_name" placeholder="Ej. Juan Pérez" required
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 bg-transparent text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/20 focus:border-green-500 transition-all text-sm" />
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
                                Celular
                            </label>
                            <input type="tel" name="user_cel" placeholder="55-30-68-XX-XX" required
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 bg-transparent text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/20 focus:border-green-500 transition-all text-sm" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="modelo" class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
                            Selecciona tu modelo
                        </label>
                        <select id="modelo" name="modelo" required
                                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-green-500/20 focus:border-green-500 transition-all text-sm cursor-pointer">
                            <option value="" class="text-gray-400">-- Por favor, elige una opción --</option>
                            <option value="360">Xbox 360</option>
                            <option value="series-s">Xbox Series S</option>
                            <option value="series-x">Xbox Series X</option>
                        </select>
                    </div>   

                    <div class="flex flex-col gap-2">
                        <p class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
                            ¿Qué servicio desea?
                        </p>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1">
                            <label class="flex items-center gap-2 p-3 rounded-xl border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50 cursor-pointer transition-all text-sm">
                                <input type="radio" id="opcion-express" name="opcion" value="express" required
                                       class="w-4 h-4 text-green-600 border-gray-300 focus:ring-green-500/20 accent-green-600" />
                                <span class="text-gray-700 dark:text-gray-300 font-medium">Express</span>
                            </label>

                            <label class="flex items-center gap-2 p-3 rounded-xl border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50 cursor-pointer transition-all text-sm">
                                <input type="radio" id="opcion-profunda" name="opcion" value="profunda"
                                       class="w-4 h-4 text-green-600 border-gray-300 focus:ring-green-500/20 accent-green-600" />
                                <span class="text-gray-700 dark:text-gray-300 font-medium">Profunda</span>
                            </label>

                            <label class="flex items-center gap-2 p-3 rounded-xl border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50 cursor-pointer transition-all text-sm">
                                <input type="radio" id="opcion-full" name="opcion" value="full"
                                       class="w-4 h-4 text-green-600 border-gray-300 focus:ring-green-500/20 accent-green-600" />
                                <span class="text-gray-700 dark:text-gray-300 font-medium">Full</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
                            Mensaje
                        </label>
                        <textarea name="message" placeholder="¿En qué te podemos ayudar? Cuéntanos los síntomas de tu consola..." rows="4" required
                                  class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 bg-transparent text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/20 focus:border-green-500 transition-all text-sm resize-none"></textarea>
                    </div>

                    <div class="pt-2">
                        <button type="submit" id="btn-enviar"
                                class="w-full py-3 px-6 text-sm font-bold text-white uppercase tracking-wider rounded-xl
                                       bg-green-600 hover:bg-green-700 active:scale-[0.99]
                                       shadow-md shadow-green-600/10 dark:shadow-none
                                       transition-all duration-200 cursor-pointer">
                            Enviar Mensaje
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>